<UserControl x:Class="CafManagerConection.App.Views.ConsolaDeTraza"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="CeldaDeTraza" TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Fallo}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Destructivo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Tarjeta}" Padding="0" Margin="0,6,0,0">
        <DockPanel>

            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource Borde}" BorderThickness="0,0,0,1"
                    Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Traza del canal de comandos"
                               Style="{StaticResource Etiqueta}"
                               Margin="2,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBox Grid.Column="1" x:Name="_filtro"
                             Style="{StaticResource CampoBusqueda}"
                             Tag="Filtrar por comando, servidor o salida…"
                             MaxWidth="360" HorizontalAlignment="Left"
                             TextChanged="AlFiltrar" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton x:Name="_seguir" Content="Seguir"
                                      Style="{StaticResource AccesoPanel}"
                                      Height="26" Padding="10,0" MinWidth="60"
                                      IsChecked="True"
                                      ToolTip="Bajar sola con cada intercambio nuevo"
                                      Click="AlAlternarSeguir" />

                        <Button x:Name="_pausa" Content="Pausar"
                                Margin="6,0,0,0"
                                Style="{StaticResource BotonSecundario}"
                                Height="26" Padding="10,0" FontWeight="Normal"
                                ToolTip="Dejar de grabar sin perder lo que ya está"
                                Click="AlPausar" />

                        <Button Content="Limpiar"
                                Style="{StaticResource BotonSecundario}"
                                Height="26" Padding="10,0" Margin="6,0,0,0"
                                FontWeight="Normal"
                                Click="AlLimpiar" />

                        <Button Content="Copiar"
                                Style="{StaticResource BotonSecundario}"
                                Height="26" Padding="10,0" Margin="6,0,0,0"
                                FontWeight="Normal"
                                ToolTip="Copiar al portapapeles lo que se está viendo"
                                Click="AlCopiar" />

                        <Button Content="Registros"
                                Style="{StaticResource BotonSecundario}"
                                Height="26" Padding="10,0" Margin="6,0,0,0"
                                FontWeight="Normal"
                                ToolTip="Abrir la carpeta de registros de la aplicación"
                                Click="AlAbrirRegistros" />

                        <Button Content="✕"
                                Style="{StaticResource BotonTenue}"
                                Width="26" Height="26" Padding="0" Margin="6,0,0,0"
                                ToolTip="Cerrar la consola (F12)"
                                Click="AlCerrar" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,6">
                <TextBlock x:Name="_resumen" Style="{StaticResource Tenue}" />

                <TextBlock x:Name="_fallos" Margin="10,0,0,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource Destructivo}"
                           Visibility="Collapsed" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="_columnaDetalle" Width="380" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0" x:Name="_tabla"
                          Margin="4,4,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CellStyle="{StaticResource CeldaDeTraza}"
                          SelectionChanged="AlElegirFila">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="94" />
                        <DataGridTextColumn Header="Servidor" Binding="{Binding Servidor}"
                                            Width="180" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="84" />
                        <DataGridTextColumn Header="Tardó" Binding="{Binding Tardo}" Width="72" />
                        <DataGridTextColumn Header="Salida" Binding="{Binding Estado}" Width="58" />
                        <DataGridTextColumn Header="Enviado" Binding="{Binding Resumen}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Column="1" Width="5" />

                <TextBox Grid.Column="2" x:Name="_detalle"
                         Style="{StaticResource CampoMultilinea}"
                         Margin="4,4,4,0"
                         IsReadOnly="True"
                         FontFamily="{StaticResource FuenteMono}"
                         FontSize="{StaticResource CuerpoChico}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         Text="Elegí una fila para ver lo que se mandó y lo que contestó." />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
