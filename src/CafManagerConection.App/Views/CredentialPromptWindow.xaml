<Window x:Class="CafManagerConection.App.Views.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="Credencial"
        Background="{DynamicResource Fondo}">

    <StackPanel Margin="18">
        <TextBlock x:Name="_encabezado" TextWrapping="Wrap" Margin="0,0,0,14" />

        <TextBlock Text="Usuario" Style="{StaticResource Etiqueta}" Margin="0,0,0,4" />
        <TextBox x:Name="_usuario" />

        <StackPanel x:Name="_bloqueDominio">
            <TextBlock Text="Dominio (opcional)" Style="{StaticResource Etiqueta}"
                       Margin="0,12,0,4" />
            <TextBox x:Name="_dominio" />
        </StackPanel>

        <TextBlock Text="Contraseña" Style="{StaticResource Etiqueta}" Margin="0,12,0,4" />
        <PasswordBox x:Name="_clave" />

        <CheckBox x:Name="_recordar" Margin="0,14,0,0" IsChecked="True"
                  Content="Guardar en el Administrador de credenciales de Windows" />

        <TextBlock x:Name="_error" Foreground="{DynamicResource Destructivo}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    IsCancel="True" MinWidth="100" />
            <Button Content="Conectar" Style="{StaticResource BotonPrimario}"
                    IsDefault="True" MinWidth="100" Margin="8,0,0,0"
                    Click="AlAceptar" />
        </StackPanel>
    </StackPanel>
</Window>
