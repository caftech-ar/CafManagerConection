<UserControl x:Class="CafManagerConection.App.Panels.TunnelsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:temas="clr-namespace:CafManagerConection.App.Themes">

    <DockPanel Background="{DynamicResource Fondo}">

        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource Borde}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <TextBlock Text="Túneles" Style="{StaticResource Etiqueta}"
                           Margin="0" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Levantar"
                            temas:BotonConIcono.Clave="{x:Static temas:IconosDeLaInterfaz.Levantar}" Style="{StaticResource BotonPrimario}"
                            Height="26" Padding="10,0" FontWeight="Normal"
                            Click="AlLevantar" />
                    <Button Content="Bajar"
                            temas:BotonConIcono.Clave="{x:Static temas:IconosDeLaInterfaz.Detener}" Style="{StaticResource BotonSecundario}"
                            Height="26" Padding="10,0" FontWeight="Normal" Margin="4,0,0,0"
                            Click="AlBajar" />
                    <Button Content="Editar…"
                            temas:BotonConIcono.Clave="{x:Static temas:IconosDeLaInterfaz.Editar}" Style="{StaticResource BotonSecundario}"
                            Height="26" Padding="10,0" FontWeight="Normal" Margin="12,0,0,0"
                            Click="AlEditar" />
                    <Button x:Name="_quitar" Content="Quitar"
                            temas:BotonConIcono.Clave="{x:Static temas:IconosDeLaInterfaz.Quitar}"
                            Style="{StaticResource BotonDestructivo}"
                            Height="26" Padding="10,0" FontWeight="Normal" Margin="4,0,0,0"
                            IsEnabled="False" Click="AlQuitar" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="_resumen" DockPanel.Dock="Bottom"
                   Style="{StaticResource Tenue}" Margin="12,8" TextWrapping="Wrap" />

        <DataGrid x:Name="_lista" Margin="4,4,4,0" SelectionChanged="AlElegir">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="1.6*" />
                <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="0.7*" />
                <DataGridTextColumn Header="Destino remoto" Binding="{Binding Remoto}" Width="1.8*" />
                <DataGridTemplateColumn Header="Estado" Width="1*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <temas:IconoVectorial Tamano="13" Margin="0,0,6,0"
                                                      VerticalAlignment="Center"
                                                      Clave="{Binding Identidad}"
                                                      Pincel="{Binding IdentidadConocida,
                                                              Converter={StaticResource PincelEnfasis}}" />
                                <TextBlock Text="{Binding Estado}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
