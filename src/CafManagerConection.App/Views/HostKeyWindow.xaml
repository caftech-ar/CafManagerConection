<Window x:Class="CafManagerConection.App.Views.HostKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Fondo}">

    <StackPanel Margin="20">
        <TextBlock x:Name="_titulo" Style="{StaticResource Titulo}" TextWrapping="Wrap" />

        <TextBlock x:Name="_explicacion" Style="{StaticResource Tenue}"
                   TextWrapping="Wrap" Margin="0,10,0,0" />

        <TextBlock Text="Fingerprint presentado" Style="{StaticResource Etiqueta}"
                   Margin="0,18,0,4" />
        <Border Style="{StaticResource Tarjeta}" Padding="10,8">
            <TextBox x:Name="_presentado" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" Height="Auto" Padding="0"
                     FontFamily="{StaticResource FuenteMono}" />
        </Border>

        <StackPanel x:Name="_bloqueConocido" Visibility="Collapsed">
            <TextBlock Text="Fingerprint que se conocía" Style="{StaticResource Etiqueta}"
                       Margin="0,14,0,4" />
            <Border Style="{StaticResource Tarjeta}" Padding="10,8">
                <TextBox x:Name="_conocido" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Height="Auto" Padding="0"
                         FontFamily="{StaticResource FuenteMono}" />
            </Border>
        </StackPanel>

        <CheckBox x:Name="_recordar" Content="Recordar este servidor" Margin="0,18,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="_aceptar" Content="Aceptar"
                    Style="{StaticResource BotonPrimario}" MinWidth="110"
                    Click="AlAceptar" />
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
