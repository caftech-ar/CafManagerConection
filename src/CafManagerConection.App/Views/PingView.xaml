<UserControl x:Class="CafManagerConection.App.Views.PingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Lateral}"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource Tenue}"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Text="Cada equipo se prueba con un ping y con una conexión a su puerto. Desplegá una fila para probar el resto de los puertos que esa conexión tiene configurados. Es una foto del momento: no se repite sola." />

        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0">
            <TreeView x:Name="_arbol"
                      Background="Transparent"
                      BorderThickness="0">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding Desplegada, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:FilaDePing}"
                                              xmlns:local="clr-namespace:CafManagerConection.App.Views"
                                              ItemsSource="{Binding Puertos}">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Detalle}">
                            <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Color}" />
                            <TextBlock Text="{Binding Nombre}" MinWidth="160"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Host}" MinWidth="140"
                                       Style="{StaticResource Tenue}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Puerto}" MinWidth="60"
                                       Style="{StaticResource Tenue}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Estado}" VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <DataTemplate DataType="{x:Type local:FilaDePuerto}"
                                  xmlns:local="clr-namespace:CafManagerConection.App.Views">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Color}" />
                            <TextBlock Text="{Binding Puerto}" MinWidth="60"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Descripcion}" MinWidth="220"
                                       Style="{StaticResource Tenue}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Estado}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="_resumen"
                       Style="{StaticResource Tenue}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left" />

            <Button x:Name="_repetir"
                    Content="Repetir"
                    Style="{StaticResource BotonSecundario}"
                    Width="110"
                    HorizontalAlignment="Right"
                    Click="AlRepetir" />
        </Grid>
    </Grid>
</UserControl>
