<Window x:Class="CafManagerConection.App.Views.ContenedorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="660" Width="880"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Lateral}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Padding="14,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="_punto" Width="9" Height="9"
                             Margin="0,0,8,0" VerticalAlignment="Center"
                             Fill="{DynamicResource EstadoInactivo}" />

                    <TextBlock x:Name="_nombre" Style="{StaticResource Titulo}"
                               FontSize="18" Margin="0" VerticalAlignment="Center" />

                    <Border x:Name="_marcaSalud" Margin="10,0,0,0" Padding="6,2"
                            CornerRadius="3" VerticalAlignment="Center"
                            Background="{DynamicResource Seleccion}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="_salud" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="_imagen" Style="{StaticResource Tenue}"
                           FontFamily="{StaticResource FuenteMono}"
                           Margin="17,6,0,0" TextTrimming="CharacterEllipsis" />

                <UniformGrid x:Name="_metricas" Rows="1" Margin="17,14,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" x:Name="_marcoAviso"
                Margin="0,10,0,0" Padding="12,8"
                CornerRadius="4"
                BorderThickness="3,0,0,0"
                Background="{DynamicResource Seleccion}"
                BorderBrush="{DynamicResource Destructivo}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="_aviso"
                           TextWrapping="Wrap" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Destructivo}" />

                <Button Grid.Column="1" Content="Descartar"
                        Style="{StaticResource BotonTenue}"
                        Height="24" Padding="10,0" Margin="10,0,0,0" FontWeight="Normal"
                        Click="AlDescartarAviso" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <StackPanel x:Name="_datos" />
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" />

            <Border Grid.Column="2" Style="{StaticResource TarjetaConsola}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SuperficieConsola}"
                            BorderBrush="{DynamicResource BordeConsola}" BorderThickness="0,0,0,1"
                            CornerRadius="7,7,0,0"
                            Padding="14,9">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" Width="14" Height="14"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Data="{DynamicResource IconoPanelSupervisor}"
                                      Fill="{DynamicResource ConsolaAcento}" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="_tituloRegistro" Text="Registro"
                                               FontWeight="SemiBold" Margin="0"
                                               Foreground="{DynamicResource TextoConsola}" />

                                    <TextBlock x:Name="_cuentaLineas" Style="{StaticResource Tenue}"
                                               Foreground="{DynamicResource TextoConsolaTenue}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />

                                    <Ellipse x:Name="_puntoEnVivo" Width="6" Height="6"
                                             Margin="8,0,0,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource ConsolaOk}"
                                             Visibility="Collapsed" />
                                </StackPanel>

                                <Button x:Name="_forzarRegistro" Grid.Column="2"
                                        Content="Forzar lectura"
                                        Style="{StaticResource BotonConsola}"
                                        Height="24" Padding="12,0" Margin="0,0,6,0"
                                        ToolTip="Volver a leer el registro ahora, sin esperar una línea nueva"
                                        Click="AlForzarRegistro" />

                                <Button x:Name="_seguir" Grid.Column="3"
                                        Content="Seguir en vivo"
                                        Style="{StaticResource BotonConsola}"
                                        Height="24" Padding="12,0" Click="AlSeguir" />
                            </Grid>

                            <TextBlock x:Name="_monitoreado"
                                       FontFamily="{StaticResource FuenteMono}"
                                       FontSize="{StaticResource CuerpoChico}"
                                       Foreground="{DynamicResource TextoConsolaTenue}"
                                       Margin="22,5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource FondoConsola}"
                            CornerRadius="0,0,7,7">
                        <Grid>
                            <RichTextBox x:Name="_registro"
                                         IsReadOnly="True"
                                         IsDocumentEnabled="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextoConsola}"
                                         Padding="12,10"
                                         FontFamily="{StaticResource FuenteMono}"
                                         FontSize="12"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />

                            <TextBlock x:Name="_registroVacio"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource TextoConsolaTenue}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="320"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="_reiniciar" Content="Reiniciar…"
                        Style="{StaticResource BotonSecundario}"
                        MinWidth="110" Click="AlReiniciar" />

                <Button x:Name="_detener" Content="Detener…"
                        Style="{StaticResource BotonDestructivo}"
                        MinWidth="100" Margin="8,0,0,0" Click="AlDetener" />

                <Button x:Name="_iniciar" Content="Iniciar…"
                        Style="{StaticResource BotonSecundario}"
                        MinWidth="100" Margin="8,0,0,0"
                        Visibility="Collapsed" Click="AlIniciar" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="_estado" Style="{StaticResource Tenue}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="320" />

                <Button Content="Actualizar" Style="{StaticResource BotonSecundario}"
                        MinWidth="100" Click="AlActualizar" />

                <Button Content="Cerrar" Style="{StaticResource BotonPrimario}"
                        IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
