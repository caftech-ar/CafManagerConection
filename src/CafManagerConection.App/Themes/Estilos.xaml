        <Setter Property="Foreground" Value="{DynamicResource TextoConsola}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="pildora" Background="Transparent"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource TextoDeBoton}" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pildora" Property="Background"
                                    Value="{DynamicResource RealceConsola}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextoConsolaFuerte}" />
