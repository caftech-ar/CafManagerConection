<UserControl x:Class="CafManagerConection.App.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:temas="clr-namespace:CafManagerConection.App.Themes"
             xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="_columnaPanel" Width="0" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <!-- El margen va acá y no en el panel de WinForms: con 48 px de padding el texto seguía pegado al canto -->
            <Border x:Name="_marcoSesion" Visibility="Collapsed">
                <DockPanel>
                    <Border x:Name="_barraSesion" DockPanel.Dock="Top"
                            Margin="6,5,6,0"
                            Padding="3,2"
                            CornerRadius="7"
                            Background="{DynamicResource SuperficieConsola}"
                            BorderBrush="{DynamicResource BordeConsola}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3"
                                              Opacity="0.55" Color="Black" />
                        </Border.Effect>

                        <StackPanel x:Name="_accionesSesion" Orientation="Horizontal" />
                    </Border>

                    <Border x:Name="_barraBusqueda" DockPanel.Dock="Top"
                            Margin="6,5,6,0"
                            Padding="8,3"
                            CornerRadius="7"
                            Background="{DynamicResource SuperficieConsola}"
                            BorderBrush="{DynamicResource BordeConsola}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3"
                                              Opacity="0.55" Color="Black" />
                        </Border.Effect>

                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="_textoBusqueda"
                                     Style="{StaticResource CampoBusqueda}"
                                     Tag="Buscar en el historial…"
                                     Width="240"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextoConsola}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AlCambiarTextoDeBusqueda"
                                     PreviewKeyDown="AlTeclearEnBusqueda" />

                            <!-- Ancho fijo: sin él, pasar de «3 de 17» a «1 de 4» corría toda la barra hacia la derecha -->
                            <TextBlock x:Name="_contadorBusqueda"
                                       Text="Sin coincidencias"
                                       Foreground="{DynamicResource TextoConsolaTenue}"
                                       FontSize="{StaticResource CuerpoChico}"
                                       VerticalAlignment="Center"
                                       MinWidth="92"
                                       Margin="10,0" />

                            <Button x:Name="_botonBusquedaAnterior"
                                    Style="{StaticResource AccionDeSesion}"
                                    Width="26" Padding="0"
                                    ToolTip="Coincidencia anterior (Shift+Enter)"
                                    Click="AlPedirCoincidenciaAnterior">
                                <temas:IconoVectorial Clave="{x:Static temas:IconosDeLaInterfaz.BusquedaAnterior}"
                                                      Tamano="15"
                                                      Pincel="{DynamicResource TextoConsola}" />
                            </Button>

                            <Button x:Name="_botonBusquedaSiguiente"
                                    Style="{StaticResource AccionDeSesion}"
                                    Width="26" Padding="0"
                                    ToolTip="Coincidencia siguiente (Enter)"
                                    Click="AlPedirCoincidenciaSiguiente">
                                <temas:IconoVectorial Clave="{x:Static temas:IconosDeLaInterfaz.BusquedaSiguiente}"
                                                      Tamano="15"
                                                      Pincel="{DynamicResource TextoConsola}" />
                            </Button>

                            <Button x:Name="_botonCerrarBusqueda"
                                    Style="{StaticResource AccionDeSesion}"
                                    Width="26" Padding="0"
                                    Margin="8,0,0,0"
                                    ToolTip="Cerrar (Esc)"
                                    Click="AlCerrarBusqueda">
                                <temas:IconoVectorial Clave="{x:Static temas:IconosDeLaInterfaz.CerrarBusqueda}"
                                                      Tamano="15"
                                                      Pincel="{DynamicResource TextoConsola}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Padding vertical y alto del contenido copian a _barraSesion (2 y los 22 del
                         estilo AccionDeSesion): las dos barras tienen que medir lo mismo -->
                    <Border x:Name="_franjaMetricas" DockPanel.Dock="Bottom"
                            Margin="6,0,6,5"
                            Padding="10,2"
                            CornerRadius="7"
                            Background="{DynamicResource SuperficieConsola}"
                            BorderBrush="{DynamicResource BordeConsola}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3"
                                              Opacity="0.55" Color="Black" />
                        </Border.Effect>

                        <StackPanel x:Name="_medidas" Orientation="Horizontal"
                                    Height="22" VerticalAlignment="Center" />
                    </Border>

                    <wf:WindowsFormsHost x:Name="_host" />
                </DockPanel>
            </Border>

            <StackPanel x:Name="_aviso" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="_mensaje" Text="Conectando…"
                           Style="{StaticResource Tenue}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" />

                <Button x:Name="_reintentar" Content="Reintentar"
                        Style="{StaticResource BotonSecundario}"
                        HorizontalAlignment="Center" Margin="0,14,0,0"
                        MinWidth="120" Visibility="Collapsed"
                        Click="AlReintentar" />
            </StackPanel>
        </Grid>

        <GridSplitter x:Name="_divisor" Grid.Column="1" Visibility="Collapsed" />

        <Border Grid.Column="2" Background="{DynamicResource Fondo}">
            <ContentControl x:Name="_panel" />
        </Border>

        <!-- Arranca oculta: vacia seguia ocupando 44 px con su margen, su borde y su sombra, y en
             una sesion RDP -que no registra ningun panel- eso era un recuadro vacio al costado
             del escritorio remoto. -->
        <Border x:Name="_marcoBarra" Grid.Column="3"
                Margin="6,5,5,5"
                Padding="2,3"
                CornerRadius="7"
                Visibility="Collapsed"
                Background="{DynamicResource Apagado}"
                BorderBrush="{DynamicResource BordeFuerte}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                  Opacity="0.22" Color="Black" />
            </Border.Effect>

            <StackPanel x:Name="_barra" Width="26" />
        </Border>
    </Grid>
</UserControl>
