<Window x:Class="CafManagerConection.App.Views.ClaveMaestraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clave maestra"
        Width="480" SizeToContent="Height"
        MinHeight="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Fondo}">

    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="_titulo"
                   Style="{StaticResource Titulo}"
                   FontSize="16"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,6" />

        <TextBlock x:Name="_explicacion"
                   Style="{StaticResource Tenue}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <TextBlock Text="Clave maestra" Style="{StaticResource Etiqueta}" />
        <PasswordBox x:Name="_clave" Margin="0,4,0,4"
                     PasswordChanged="AlEscribir" />

        <StackPanel x:Name="_bloqueRepetir">
            <TextBlock Text="Repetila" Style="{StaticResource Etiqueta}" Margin="0,6,0,0" />
            <PasswordBox x:Name="_repetir" Margin="0,4,0,4"
                         PasswordChanged="AlEscribir" />
        </StackPanel>

        <TextBlock x:Name="_requisitos"
                   Style="{StaticResource Tenue}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />

        <TextBlock x:Name="_fuerza"
                   Style="{StaticResource Tenue}"
                   Margin="0,6,0,0" />

        <Border x:Name="_avisoDePerdida"
                Background="{DynamicResource Apagado}"
                BorderBrush="{DynamicResource Borde}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radio}"
                Padding="12,10"
                Margin="0,14,0,0"
                Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap"
                       Text="Si perdés esta clave maestra, las contraseñas guardadas no se recuperan. No hay forma de recuperarlas: ni desde acá, ni con una copia de seguridad, ni pidiéndosela a nadie. Guardala donde la vayas a encontrar." />
        </Border>

        <CheckBox x:Name="_recordarEquipo"
                  Margin="0,14,0,0"
                  Visibility="Collapsed"
                  Content="Recordar este equipo y no volver a pedirla acá" />

        <TextBlock x:Name="_avisoDeRecordar"
                   Style="{StaticResource Tenue}"
                   TextWrapping="Wrap"
                   Margin="22,4,0,0"
                   Visibility="Collapsed"
                   Text="Con esto encendido, cualquier programa que corra con tu usuario de Windows puede llegar a las contraseñas sin la clave maestra. Apagado, te la pide en cada arranque." />

        <TextBlock x:Name="_error"
                   Style="{StaticResource Tenue}"
                   Foreground="{DynamicResource EstadoError}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="_botonCancelar" Content="Después"
                    Style="{StaticResource BotonSecundario}"
                    MinWidth="90" Padding="12,0"
                    Click="AlCancelar" />

            <Button x:Name="_botonAceptar" Content="Aceptar"
                    Style="{StaticResource BotonPrimario}"
                    MinWidth="110" Margin="8,0,0,0" Padding="12,0"
                    IsDefault="True"
                    Click="AlAceptar" />
        </StackPanel>
    </StackPanel>
</Window>
