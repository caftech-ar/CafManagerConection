<Window x:Class="CafManagerConection.App.Views.MuestraDeIconosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catálogo de iconos"
        Width="1020" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Fondo}"
        Foreground="{DynamicResource Texto}">

    <DockPanel Margin="16">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tamaño" Style="{StaticResource Tenue}" VerticalAlignment="Center" />
                <ComboBox x:Name="_tamano" Width="72" Margin="8,0,0,0"
                          SelectionChanged="AlCambiarLaMuestra" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="20,0,0,0">
                <TextBlock Text="Color" Style="{StaticResource Tenue}" VerticalAlignment="Center" />
                <ComboBox x:Name="_color" Width="132" Margin="8,0,0,0"
                          SelectionChanged="AlCambiarLaMuestra" />
            </StackPanel>

            <TextBlock x:Name="_resumen" Grid.Column="2" Style="{StaticResource Tenue}"
                       VerticalAlignment="Center" Margin="20,0,0,0" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="_grupos">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
