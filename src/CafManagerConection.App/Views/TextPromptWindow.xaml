<Window x:Class="CafManagerConection.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Fondo}">

    <StackPanel Margin="18">
        <TextBlock x:Name="_etiqueta" Style="{StaticResource Etiqueta}" />
        <TextBox x:Name="_valor" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    IsCancel="True" MinWidth="90" />
            <Button Content="Aceptar" Style="{StaticResource BotonPrimario}"
                    IsDefault="True" MinWidth="90" Margin="8,0,0,0"
                    Click="AlAceptar" />
        </StackPanel>
    </StackPanel>
</Window>
