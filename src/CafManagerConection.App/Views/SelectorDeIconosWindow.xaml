<Window x:Class="CafManagerConection.App.Views.SelectorDeIconosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:temas="clr-namespace:CafManagerConection.App.Themes"
        Title="Elegir icono"
        Width="840" Height="660" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Fondo}"
        Foreground="{DynamicResource Texto}">

    <Window.Resources>
        <Style x:Key="CeldaDeIcono" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="_caja" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="2" CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="_caja" Property="Background"
                                        Value="{DynamicResource Apagado}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="_caja" Property="Background"
                                        Value="{DynamicResource Seleccion}" />
                                <Setter TargetName="_caja" Property="BorderBrush"
                                        Value="{DynamicResource Primario}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="_busqueda" Style="{StaticResource CampoBusqueda}"
                     TextChanged="AlEscribir" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <RadioButton x:Name="_todo" Style="{StaticResource ChipDeFiltro}" Content="Todo"
                             Checked="AlCambiarLaFamilia" />
                <RadioButton x:Name="_conceptos" Style="{StaticResource ChipDeFiltro}"
                             Content="Conceptos" Margin="6,0,0,0" Checked="AlCambiarLaFamilia" />
                <RadioButton x:Name="_logos" Style="{StaticResource ChipDeFiltro}" Content="Logos"
                             Margin="6,0,0,0" Checked="AlCambiarLaFamilia" />
            </StackPanel>

            <ComboBox x:Name="_grupo" Grid.Column="2" Width="196" Margin="10,0,0,0"
                      SelectionChanged="AlCambiarElGrupo" />
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="_cuenta" Style="{StaticResource Tenue}" VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Sin icono" Style="{StaticResource BotonTenue}" MinWidth="110"
                        Click="AlQuitarElIcono" />
                <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                        IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
                <Button x:Name="_elegir" Content="Elegir" Style="{StaticResource BotonPrimario}"
                        IsDefault="True" MinWidth="100" Margin="8,0,0,0" Click="AlElegir" />
            </StackPanel>
        </Grid>

        <Grid>
            <ListBox x:Name="_grilla"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource CeldaDeIcono}"
                     MouseDoubleClick="AlHacerDobleClic"
                     SelectionChanged="AlCambiarLaSeleccion">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="92" ToolTip="{Binding}">
                            <Border Height="42">
                                <temas:IconoVectorial Clave="{Binding Clave}" Tamano="24"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Etiqueta}" FontSize="10.5"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="4,0,4,6" MaxHeight="28"
                                       Foreground="{DynamicResource TextoTenue}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="2,14,0,8"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextoTenue}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>

            <TextBlock x:Name="_vacio" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       Style="{StaticResource Tenue}" />
        </Grid>

    </DockPanel>
</Window>
