            F0 M4 4.5C4 3.67157 4.67157 3 5.5 3H14.5C15.3284 3 16 3.67157 16 4.5V15.5C16 16.3284 15.3284 17 14.5 17H5.5C4.67157 17 4 16.3284 4 15.5V4.5Z M7.25 5.5C6.55964 5.5 6 6.05964 6 6.75C6 7.44036 6.55964 8 7.25 8C7.94036 8 8.5 7.44036 8.5 6.75C8.5 6.05964 7.94036 5.5 7.25 5.5Z M5.6 15L9.2 10.2L11.6 13.4L13 11.6L14.4 15H5.6Z
        </StreamGeometry>

        <StreamGeometry x:Key="IconoArchivoRegistro">
            F0 M5.5 2H14.5C15.3284 2 16 2.67157 16 3.5V16.5C16 17.3284 15.3284 18 14.5 18H5.5C4.67157 18 4 17.3284 4 16.5V3.5C4 2.67157 4.67157 2 5.5 2Z M6.4 5.6H7.6V6.8H6.4Z M8.8 5.6H13.6V6.8H8.8Z M6.4 9H7.6V10.2H6.4Z M8.8 9H13.6V10.2H8.8Z M6.4 12.4H7.6V13.6H6.4Z M8.8 12.4H12V13.6H8.8Z
        </StreamGeometry>

        <HierarchicalDataTemplate DataType="{x:Type panels:NodoRemoto}"
                                  ItemsSource="{Binding Hijos}">
            <Grid Margin="0,1" ToolTip="{Binding Detalle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path x:Name="_icono" Grid.Column="0"
                      Width="16" Height="16"
                      Margin="0,0,7,0" VerticalAlignment="Center"
                      Stretch="Uniform"
                      Data="{Binding Geometria}"
                      Fill="{Binding ClaveDePincel, Converter={StaticResource PincelClave}}" />

                <TextBlock x:Name="_nombre" Grid.Column="1"
                           Text="{Binding Nombre}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontWeight="{Binding EsCarpeta,
                                        Converter={StaticResource ASiNegrita}}" />

                <TextBlock Grid.Column="2" Text="{Binding Tamano}"
                           Style="{StaticResource Tenue}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />

                <TextBlock Grid.Column="3" Text="{Binding Modificado}"
                           Style="{StaticResource Tenue}"
                           Margin="12,0,6,0" VerticalAlignment="Center" />
            </Grid>

            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding EsMarcador}" Value="True">
                    <Setter TargetName="_icono" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="_nombre" Property="Foreground"
                            Value="{DynamicResource TextoTenue}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource Fondo}">

        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource Borde}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <StackPanel>
                <TextBlock Text="Archivos (SFTP)" Style="{StaticResource Etiqueta}"
                           Margin="0,0,0,6" />

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="_botonSubir"
                            Content="Subir un archivo o directorio…"
                            Style="{StaticResource BotonSecundario}"
                            Height="30" Padding="10,0" FontWeight="Normal"
                            ToolTip="Confirma a qué carpeta del servidor va antes de transferir"
                            Click="AlSubir">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Subir un archivo…" Click="AlSubirArchivos" />
                                <MenuItem Header="Subir un directorio…" Click="AlSubirCarpeta" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="Bajar…" Style="{StaticResource BotonSecundario}"
                            Height="30" Padding="10,0" FontWeight="Normal" Margin="4,0,0,0"
                            ToolTip="Pregunta dónde guardar lo seleccionado"
                            Click="AlBajar" />

                    <Button Content="Actualizar" Style="{StaticResource BotonSecundario}"
                            Height="30" Padding="10,0" FontWeight="Normal" Margin="4,0,0,0"
                            ToolTip="Vuelve a leer el nivel seleccionado"
                            Click="AlActualizar" />
                </StackPanel>

                <TextBlock x:Name="_destino" Style="{StaticResource Tenue}"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="12,8">
            <StackPanel>
                <ProgressBar x:Name="_progreso" Visibility="Collapsed" Margin="0,0,0,6" />
                <TextBlock x:Name="_resumen" Style="{StaticResource Tenue}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TreeView x:Name="_arbol" Margin="4,4,4,0"
                  SelectedItemChanged="AlCambiarSeleccion">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Descargar…" Click="AlBajar">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconoGuardarComo}"
                                  Fill="{DynamicResource Texto}"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Nueva carpeta…" Click="AlCrearCarpeta">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconoCarpeta}"
                                  Fill="{DynamicResource Texto}"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Renombrar…" Click="AlRenombrar" />
                    <Separator />
                    <MenuItem Header="Eliminar del servidor" Click="AlEliminar">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconoEliminarArchivo}"
                                  Fill="{DynamicResource Destructivo}"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
    </DockPanel>
</UserControl>
