<UserControl x:Class="CafManagerConection.App.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration">

    <UserControl.Resources>
        <StreamGeometry x:Key="IconoBusquedaAnterior">F1 M5.65 12.35C5.45 12.15 5.45 11.85 5.65 11.65L9.65 7.65C9.85 7.45 10.15 7.45 10.35 7.65L14.35 11.65C14.55 11.85 14.55 12.15 14.35 12.35C14.15 12.55 13.85 12.55 13.65 12.35L10 8.71L6.35 12.35C6.15 12.55 5.85 12.55 5.65 12.35Z</StreamGeometry>
        <StreamGeometry x:Key="IconoBusquedaSiguiente">F1 M14.35 7.65C14.55 7.85 14.55 8.15 14.35 8.35L10.35 12.35C10.15 12.55 9.85 12.55 9.65 12.35L5.65 8.35C5.45 8.15 5.45 7.85 5.65 7.65C5.85 7.45 6.15 7.45 6.35 7.65L10 11.29L13.65 7.65C13.85 7.45 14.15 7.45 14.35 7.65Z</StreamGeometry>
        <StreamGeometry x:Key="IconoCerrarBusqueda">F1 M5.65 5.65C5.85 5.45 6.15 5.45 6.35 5.65L10 9.29L13.65 5.65C13.85 5.45 14.15 5.45 14.35 5.65C14.55 5.85 14.55 6.15 14.35 6.35L10.71 10L14.35 13.65C14.55 13.85 14.55 14.15 14.35 14.35C14.15 14.55 13.85 14.55 13.65 14.35L10 10.71L6.35 14.35C6.15 14.55 5.85 14.55 5.65 14.35C5.45 14.15 5.45 13.85 5.65 13.65L9.29 10L5.65 6.35C5.45 6.15 5.45 5.85 5.65 5.65Z</StreamGeometry>
        <StreamGeometry x:Key="IconoPantallaCompleta">F1 M3 3H8.5V5H5V8.5H3ZM17 3H11.5V5H15V8.5H17ZM3 17H8.5V15H5V11.5H3ZM17 17H11.5V15H15V11.5H17Z</StreamGeometry>
        <StreamGeometry x:Key="IconoRestaurarTamano">F1 M8.5 8.5H3V6.5H6.5V3H8.5ZM11.5 8.5H17V6.5H13.5V3H11.5ZM8.5 11.5H3V13.5H6.5V17H8.5ZM11.5 11.5H17V13.5H13.5V17H11.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconoVentanaPropia">F1 M2.5 6H9.5V8H4.5V15H11.5V11H13.5V17H2.5ZM11 3H17.5V9.5H15.5V6.4L10.7 11.2L9.3 9.8L14.1 5H11Z</StreamGeometry>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="_columnaPanel" Width="0" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <!-- El margen va acá y no en el panel de WinForms: con 48 px de padding el texto seguía pegado al canto -->
            <Border x:Name="_marcoSesion" Visibility="Collapsed">
                <DockPanel>
                    <Border x:Name="_barraSesion" DockPanel.Dock="Top"
                            Margin="6,5,6,0"
                            Padding="3,2"
                            CornerRadius="7"
                            Background="{DynamicResource SuperficieConsola}"
                            BorderBrush="{DynamicResource BordeConsola}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3"
                                              Opacity="0.55" Color="Black" />
                        </Border.Effect>

                        <StackPanel x:Name="_accionesSesion" Orientation="Horizontal" />
                    </Border>

                    <Border x:Name="_barraBusqueda" DockPanel.Dock="Top"
                            Margin="6,5,6,0"
                            Padding="8,3"
                            CornerRadius="7"
                            Background="{DynamicResource SuperficieConsola}"
                            BorderBrush="{DynamicResource BordeConsola}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3"
                                              Opacity="0.55" Color="Black" />
                        </Border.Effect>

                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="_textoBusqueda"
                                     Style="{StaticResource CampoBusqueda}"
                                     Tag="Buscar en el historial…"
                                     Width="240"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextoConsola}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AlCambiarTextoDeBusqueda"
                                     PreviewKeyDown="AlTeclearEnBusqueda" />

                            <!-- Ancho fijo: sin él, pasar de «3 de 17» a «1 de 4» corría toda la barra hacia la derecha -->
                            <TextBlock x:Name="_contadorBusqueda"
                                       Text="Sin coincidencias"
                                       Foreground="{DynamicResource TextoConsolaTenue}"
                                       FontSize="{StaticResource CuerpoChico}"
                                       VerticalAlignment="Center"
                                       MinWidth="92"
                                       Margin="10,0" />

                            <Button x:Name="_botonBusquedaAnterior"
                                    Style="{StaticResource AccionDeSesion}"
                                    Width="26" Padding="0"
                                    ToolTip="Coincidencia anterior (Shift+Enter)"
                                    Click="AlPedirCoincidenciaAnterior">
                                <Path Data="{StaticResource IconoBusquedaAnterior}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Fill="{DynamicResource TextoConsola}" />
                            </Button>

                            <Button x:Name="_botonBusquedaSiguiente"
                                    Style="{StaticResource AccionDeSesion}"
                                    Width="26" Padding="0"
                                    ToolTip="Coincidencia siguiente (Enter)"
                                    Click="AlPedirCoincidenciaSiguiente">
                                <Path Data="{StaticResource IconoBusquedaSiguiente}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Fill="{DynamicResource TextoConsola}" />
                            </Button>

                            <Button x:Name="_botonCerrarBusqueda"
                                    Style="{StaticResource AccionDeSesion}"
                                    Width="26" Padding="0"
                                    Margin="8,0,0,0"
                                    ToolTip="Cerrar (Esc)"
                                    Click="AlCerrarBusqueda">
                                <Path Data="{StaticResource IconoCerrarBusqueda}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Fill="{DynamicResource TextoConsola}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <wf:WindowsFormsHost x:Name="_host" />
                </DockPanel>
            </Border>

            <StackPanel x:Name="_aviso" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="_mensaje" Text="Conectando…"
                           Style="{StaticResource Tenue}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" />

                <Button x:Name="_reintentar" Content="Reintentar"
                        Style="{StaticResource BotonSecundario}"
                        HorizontalAlignment="Center" Margin="0,14,0,0"
                        MinWidth="120" Visibility="Collapsed"
                        Click="AlReintentar" />
            </StackPanel>
        </Grid>

        <GridSplitter x:Name="_divisor" Grid.Column="1" Visibility="Collapsed" />

        <Border Grid.Column="2" Background="{DynamicResource Fondo}">
            <ContentControl x:Name="_panel" />
        </Border>

        <!-- Arranca oculta: vacia seguia ocupando 44 px con su margen, su borde y su sombra, y en
             una sesion RDP -que no registra ningun panel- eso era un recuadro vacio al costado
             del escritorio remoto. -->
        <Border x:Name="_marcoBarra" Grid.Column="3"
                Margin="6,5,5,5"
                Padding="2,3"
                CornerRadius="7"
                Visibility="Collapsed"
                Background="{DynamicResource Apagado}"
                BorderBrush="{DynamicResource BordeFuerte}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                  Opacity="0.22" Color="Black" />
            </Border.Effect>

            <StackPanel x:Name="_barra" Width="26" />
        </Border>
    </Grid>
</UserControl>
