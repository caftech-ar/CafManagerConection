<Window x:Class="CafManagerConection.App.Views.TunnelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="560" Width="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="Túneles de la conexión"
        Background="{DynamicResource Fondo}">

    <DockPanel Margin="20">

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Tenue}" Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Text="Un puerto de tu equipo se conecta a un destino visto desde el servidor. Sólo reenvío local." />

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre"
                               Style="{StaticResource Etiqueta}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Puerto local"
                               Style="{StaticResource Etiqueta}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Host remoto"
                               Style="{StaticResource Etiqueta}" />
                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Puerto remoto"
                               Style="{StaticResource Etiqueta}" />

                    <TextBox x:Name="_nombre" Grid.Row="1" Grid.Column="0" />
                    <TextBox x:Name="_puertoLocal" Grid.Row="1" Grid.Column="2" Margin="6,0" />
                    <TextBox x:Name="_hostRemoto" Grid.Row="1" Grid.Column="4" />
                    <TextBox x:Name="_puertoRemoto" Grid.Row="1" Grid.Column="6" Margin="6,0,0,0" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <CheckBox x:Name="_autoIniciar" Content="Levantar al conectar la sesión"
                              VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Quitar" Style="{StaticResource BotonSecundario}"
                                MinWidth="90" Click="AlQuitar" />
                        <Button Content="Agregar o actualizar" Style="{StaticResource BotonPrimario}"
                                MinWidth="160" Margin="8,0,0,0" Click="AlGuardar" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="_error" Foreground="{DynamicResource Destructivo}"
                           TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid x:Name="_lista" SelectionChanged="AlElegir">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" />
                    <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="0.8*" />
                    <DataGridTextColumn Header="Destino remoto" Binding="{Binding Remoto}" Width="2*" />
                    <DataGridTextColumn Header="Auto" Binding="{Binding Auto}" Width="0.7*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
