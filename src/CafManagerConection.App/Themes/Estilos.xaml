    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="{StaticResource CuerpoChico}" />
        <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Apagado}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Seleccion}" />
                <Setter Property="Foreground" Value="{DynamicResource Texto}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Primario}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextoTenue}" />
