<UserControl x:Class="CafManagerConection.App.Panels.ProcesosPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="Cabecera" TargetType="TextBlock" BasedOn="{StaticResource Tenue}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="Numero" TargetType="TextBlock" BasedOn="{StaticResource Tenue}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

    </UserControl.Resources>

    <DockPanel Background="{DynamicResource Fondo}">

        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource Borde}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="_titulo" Style="{StaticResource Etiqueta}" Margin="0"
                           Text="Procesos del servidor" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Tenue}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Sólo lectura: no hay cómo matar, señalar ni cambiar la prioridad." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource Borde}" BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Actualizar cada" Style="{StaticResource Tenue}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />

                    <ComboBox x:Name="_intervalo" Width="86" Height="24"
                              SelectionChanged="AlCambiarIntervalo" />

                    <TextBlock x:Name="_ultimaLectura" Style="{StaticResource Tenue}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Ordenar por" Style="{StaticResource Tenue}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />

                    <RadioButton x:Name="_porCpu" Content="CPU"
                                 GroupName="ordenDeProcesos" Margin="0,0,10,0"
                                 Checked="AlCambiarOrden" />
                    <RadioButton x:Name="_porMemoria" Content="Memoria"
                                 GroupName="ordenDeProcesos" Margin="0,0,10,0"
                                 Checked="AlCambiarOrden" />
                    <RadioButton x:Name="_porDisco" Content="Disco"
                                 GroupName="ordenDeProcesos"
                                 Checked="AlCambiarOrden" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="_escalada" DockPanel.Dock="Top"
                Background="{DynamicResource Seleccion}"
                Padding="12,7"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="_escaladaTexto" Grid.Column="0"
                           Style="{StaticResource Tenue}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />

                <Button x:Name="_botonEscalar" Grid.Column="1"
                        Content="Reintentar con privilegios"
                        Style="{StaticResource BotonSecundario}"
                        Height="26" Padding="10,0" Margin="10,0,0,0"
                        FontWeight="Normal"
                        Visibility="Collapsed"
                        Click="AlEscalar" />
            </Grid>
        </Border>

        <TextBlock x:Name="_resumen" DockPanel.Dock="Bottom"
                   Style="{StaticResource Tenue}"
                   Margin="12,8" TextWrapping="Wrap"
                   Text="Sin consultar" />

        <DockPanel>
            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource Borde}" BorderThickness="0,0,0,1"
                    Padding="8,4,10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="82" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Proceso" Style="{StaticResource Cabecera}"
                               TextAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource Cabecera}" />
                    <TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource Cabecera}" />
                    <TextBlock Grid.Column="3" Text="Memoria" Style="{StaticResource Cabecera}" />
                    <TextBlock Grid.Column="4" Text="Disco" Style="{StaticResource Cabecera}" />
                </Grid>
            </Border>

            <TreeView x:Name="_arbol" BorderThickness="0">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Hijos}">
                        <Border Background="Transparent" ToolTip="{Binding Ayuda}"
                                MouseLeftButtonDown="AlProcesoDobleClic">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Path Width="13" Height="13"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Data="{Binding ClaveDeIcono,
                                                Converter={StaticResource GeometriaClave}}"
                                          Fill="{DynamicResource TextoTenue}"
                                          Visibility="{Binding VisibilidadDelIcono}" />

                                    <TextBlock Text="{Binding Nombre}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding PidTexto}"
                                           Style="{StaticResource Numero}" />
                                <TextBlock Grid.Column="2" Text="{Binding Cpu}"
                                           Foreground="{Binding ColorCpu}"
                                           TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding Memoria}"
                                           Style="{StaticResource Numero}" />
                                <TextBlock Grid.Column="4" Text="{Binding Disco}"
                                           Style="{StaticResource Numero}" />
                            </Grid>
                        </Border>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>
    </DockPanel>
</UserControl>
