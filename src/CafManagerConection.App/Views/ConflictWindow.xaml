<Window x:Class="CafManagerConection.App.Views.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="El archivo ya existe"
        SizeToContent="Height" Width="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Fondo}">

    <StackPanel Margin="20">
        <TextBlock Text="El archivo ya existe en el destino" Style="{StaticResource Titulo}" />
        <TextBlock x:Name="_nombre" Style="{StaticResource Tenue}"
                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />

        <CheckBox x:Name="_paraTodos" Margin="0,18,0,0"
                  Content="Aplicar a todos los archivos de esta transferencia" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    IsCancel="True" MinWidth="90" />
            <Button Content="Omitir" Style="{StaticResource BotonSecundario}"
                    MinWidth="90" Margin="8,0,0,0" Click="AlOmitir" />
            <Button Content="Conservar ambos" Style="{StaticResource BotonSecundario}"
                    MinWidth="130" Margin="8,0,0,0" Click="AlConservarAmbos" />
            <Button Content="Sobrescribir" Style="{StaticResource BotonDestructivo}"
                    MinWidth="120" Margin="8,0,0,0" Click="AlSobrescribir" />
        </StackPanel>
    </StackPanel>
</Window>
