<UserControl x:Class="CafManagerConection.App.Panels.FilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:temas="clr-namespace:CafManagerConection.App.Themes"
             xmlns:panels="clr-namespace:CafManagerConection.App.Panels"
             AllowDrop="True"
             Drop="AlSoltarArchivos"
             DragOver="AlArrastrarEncima">

    <UserControl.Resources>

        <HierarchicalDataTemplate DataType="{x:Type panels:NodoRemoto}"
                                  ItemsSource="{Binding Hijos}">
            <Grid Margin="0,1" ToolTip="{Binding Detalle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <temas:IconoVectorial x:Name="_icono" Grid.Column="0"
                                      Tamano="16"
                                      Margin="0,0,7,0" VerticalAlignment="Center"
                                      Clave="{Binding ClaveDeIcono}"
                                      Pincel="{Binding ClaveDePincel, Converter={StaticResource PincelClave}}" />

                <TextBlock x:Name="_nombre" Grid.Column="1"
                           Text="{Binding Nombre}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontWeight="{Binding EsCarpeta,
                                        Converter={StaticResource ASiNegrita}}" />

                <TextBlock Grid.Column="2" Text="{Binding Tamano}"
                           Style="{StaticResource Tenue}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />

                <TextBlock Grid.Column="3" Text="{Binding Modificado}"
                           Style="{StaticResource Tenue}"
                           Margin="12,0,6,0" VerticalAlignment="Center" />
            </Grid>

            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding EsMarcador}" Value="True">
                    <Setter TargetName="_icono" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="_nombre" Property="Foreground"
                            Value="{DynamicResource TextoTenue}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource Fondo}">

        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource Borde}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <StackPanel>
                <TextBlock Text="Archivos (SFTP)" Style="{StaticResource Etiqueta}"
                           Margin="0,0,0,6" />

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="_botonSubir"
                            Content="Subir un archivo o directorio…"
                            temas:BotonConIcono.Clave="{x:Static temas:IconosDeLaInterfaz.Subir}"
                            Style="{StaticResource BotonSecundario}"
                            Height="30" Padding="10,0" FontWeight="Normal"
                            ToolTip="Confirma a qué carpeta del servidor va antes de transferir"
                            Click="AlSubir">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Subir un archivo…" Click="AlSubirArchivos" />
                                <MenuItem Header="Subir un directorio…" Click="AlSubirCarpeta" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="Bajar…"
                            temas:BotonConIcono.Clave="{x:Static temas:IconosDeLaInterfaz.Bajar}" Style="{StaticResource BotonSecundario}"
                            Height="30" Padding="10,0" FontWeight="Normal" Margin="4,0,0,0"
                            ToolTip="Pregunta dónde guardar lo seleccionado"
                            Click="AlBajar" />

                    <Button Content="Actualizar"
                            temas:BotonConIcono.Clave="{x:Static temas:IconosDeLaInterfaz.Refrescar}" Style="{StaticResource BotonSecundario}"
                            Height="30" Padding="10,0" FontWeight="Normal" Margin="4,0,0,0"
                            ToolTip="Vuelve a leer el nivel seleccionado"
                            Click="AlActualizar" />
                </StackPanel>

                <TextBlock x:Name="_destino" Style="{StaticResource Tenue}"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="12,8">
            <StackPanel>
                <ProgressBar x:Name="_progreso" Visibility="Collapsed" Margin="0,0,0,6" />
                <TextBlock x:Name="_resumen" Style="{StaticResource Tenue}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TreeView x:Name="_arbol" Margin="4,4,4,0"
                  SelectedItemChanged="AlCambiarSeleccion">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Descargar…" Click="AlBajar">
                        <MenuItem.Icon>
                            <temas:IconoVectorial Clave="{x:Static temas:IconosDeLaInterfaz.GuardarComo}"
                                                  Tamano="14"
                                                  Pincel="{DynamicResource Texto}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Nueva carpeta…" Click="AlCrearCarpeta">
                        <MenuItem.Icon>
                            <temas:IconoVectorial Clave="{x:Static temas:IconosDeLaInterfaz.Carpeta}"
                                                  Tamano="14"
                                                  Pincel="{DynamicResource Texto}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Renombrar…" Click="AlRenombrar" />
                    <Separator />
                    <MenuItem Header="Eliminar del servidor" Click="AlEliminar">
                        <MenuItem.Icon>
                            <temas:IconoVectorial Clave="{x:Static temas:IconosDeLaInterfaz.ArchivoEliminar}"
                                                  Tamano="14"
                                                  Pincel="{DynamicResource Destructivo}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
    </DockPanel>
</UserControl>
