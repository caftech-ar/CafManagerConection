<Window x:Class="CafManagerConection.App.Views.ProcesoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Fondo}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Padding="16,14">
            <StackPanel>
                <TextBlock x:Name="_nombre" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="_contexto" Style="{StaticResource Tenue}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0" Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                <StackPanel>
                    <Border x:Name="_avisoPermisos"
                            Background="{DynamicResource Apagado}"
                            BorderBrush="{DynamicResource Borde}" BorderThickness="1"
                            CornerRadius="{StaticResource Radio}"
                            Padding="12,10" Margin="0,0,0,14"
                            Visibility="Collapsed">
                        <StackPanel x:Name="_faltantes" />
                    </Border>

                    <StackPanel x:Name="_datos" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copiar la línea de comando" Style="{StaticResource BotonSecundario}"
                    MinWidth="180" Click="AlCopiarComando" />
            <Button Content="Cerrar" Style="{StaticResource BotonPrimario}"
                    IsDefault="True" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
