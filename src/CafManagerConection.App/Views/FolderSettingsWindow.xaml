<Window x:Class="CafManagerConection.App.Views.FolderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="880" MinWidth="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="Configuración heredable de la carpeta"
        Background="{DynamicResource Fondo}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="_encabezado" Grid.Row="0" Style="{StaticResource Tenue}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />

        <TabControl x:Name="_pestanas" Grid.Row="1" MinHeight="300">

            <TabItem Header="General">
                <Grid Margin="4,14,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Identidad" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />
                                <TextBlock Text="Descripción" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="_descripcion" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Apariencia" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />
                                <TextBlock Text="Etiqueta que presta a lo que contiene"
                                           Style="{StaticResource Etiqueta}" />
                                <ComboBox x:Name="_etiqueta" SelectionChanged="AlCambiarCampoHeredable" />
                                <TextBlock x:Name="_etiquetaHeredada" Style="{StaticResource Tenue}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />

                                <TextBlock Text="Color del icono" Style="{StaticResource Etiqueta}"
                                           Margin="0,14,0,4" />
                                <WrapPanel x:Name="_colores" />

                                <TextBlock Text="Forma del icono" Style="{StaticResource Etiqueta}"
                                           Margin="0,10,0,4" />
                                <WrapPanel x:Name="_iconos" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="_pestanaAcceso">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Acceso" />
                        <TextBlock x:Name="_avisoErrorAcceso" Text=" ⚠" FontWeight="Bold"
                                   Foreground="{DynamicResource Destructivo}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="4,14,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="Con qué entra lo que cuelga de esta carpeta mientras no defina lo suyo."
                               Style="{StaticResource Tenue}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Cuenta" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Usuario" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="_usuario" TextChanged="AlCambiarCampoHeredable" />
                                <TextBlock x:Name="_usuarioHeredado" Style="{StaticResource Tenue}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />

                                <TextBlock Text="Dominio (RDP)" Style="{StaticResource Etiqueta}"
                                           Margin="0,12,0,4" />
                                <TextBox x:Name="_dominio" TextChanged="AlCambiarCampoHeredable" />
                                <TextBlock x:Name="_dominioHeredado" Style="{StaticResource Tenue}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />

                                <TextBlock Text="Puerto" Style="{StaticResource Etiqueta}"
                                           Margin="0,12,0,4" />
                                <TextBox x:Name="_puerto" TextChanged="AlCambiarCampoHeredable" />
                                <TextBlock x:Name="_puertoHeredado" Style="{StaticResource Tenue}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Credenciales" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,4" />
                                <TextBlock Text="Una por protocolo. Dejar un campo vacío no cambia la contraseña ya guardada."
                                           Style="{StaticResource Tenue}" TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="RDP" Style="{StaticResource Etiqueta}" />
                                <PasswordBox x:Name="_claveRdp" />

                                <TextBlock Text="SSH" Style="{StaticResource Etiqueta}"
                                           Margin="0,12,0,4" />
                                <PasswordBox x:Name="_claveSsh" />

                                <TextBlock Text="Web" Style="{StaticResource Etiqueta}"
                                           Margin="0,12,0,4" />
                                <PasswordBox x:Name="_claveWeb" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="RDP">
                <Grid Margin="4,14,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Sesión" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <CheckBox x:Name="_rdpPortapapeles" Content="Portapapeles compartido"
                                          IsThreeState="True"
                                          Checked="AlCambiarCampoHeredable"
                                          Unchecked="AlCambiarCampoHeredable"
                                          Indeterminate="AlCambiarCampoHeredable" />
                                <TextBlock Text="Sin marcar/marcar/sin definir aquí (tres estados)"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,2" />
                                <TextBlock x:Name="_rdpPortapapelesHeredado"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,14"
                                           Visibility="Collapsed" />

                                <CheckBox x:Name="_rdpAjustarResolucion"
                                          Content="Ajustar la resolución remota al tamaño de la pestaña"
                                          IsThreeState="True"
                                          Checked="AlCambiarCampoHeredable"
                                          Unchecked="AlCambiarCampoHeredable"
                                          Indeterminate="AlCambiarCampoHeredable" />
                                <TextBlock Text="Sin marcar/marcar/sin definir aquí (tres estados)"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,2" />
                                <TextBlock x:Name="_rdpAjustarResolucionHeredado"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Seguridad" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <CheckBox x:Name="_rdpIgnorarCertificado"
                                          Content="Ignorar advertencias de certificado (no recomendado)"
                                          IsThreeState="True"
                                          Checked="AlCambiarCampoHeredable"
                                          Unchecked="AlCambiarCampoHeredable"
                                          Indeterminate="AlCambiarCampoHeredable" />
                                <TextBlock Text="Sin marcar/marcar/sin definir aquí (tres estados); si nadie lo define en toda la cascada, se validan: eso es lo seguro"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,2" />
                                <TextBlock x:Name="_rdpIgnorarCertificadoHeredado"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="_pestanaSsh">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SSH" />
                        <TextBlock x:Name="_avisoErrorSsh" Text=" ⚠" FontWeight="Bold"
                                   Foreground="{DynamicResource Destructivo}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="4,14,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Autenticación" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Método de autenticación"
                                           Style="{StaticResource Etiqueta}" />
                                <ComboBox x:Name="_sshMetodoAuth"
                                          SelectionChanged="AlCambiarCampoHeredable">
                                    <ComboBoxItem Content="Sin definir aquí (sigue subiendo por el árbol)" />
                                    <ComboBoxItem Content="Contraseña" />
                                    <ComboBoxItem Content="Clave privada" />
                                </ComboBox>
                                <TextBlock x:Name="_sshMetodoAuthHeredado"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />

                                <TextBlock Text="Ruta de la clave privada"
                                           Style="{StaticResource Etiqueta}" Margin="0,12,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="_clavePrivada" Grid.Column="0"
                                             TextChanged="AlCambiarRutaDeClave" />
                                    <Button Grid.Column="1" Content="..."
                                            Style="{StaticResource BotonSecundario}"
                                            MinWidth="30" Margin="6,0,0,0" Click="AlExaminarClave"
                                            ToolTip="Elegir un archivo existente" />
                                    <Button Grid.Column="2" Content="Pegar clave..."
                                            Style="{StaticResource BotonSecundario}"
                                            Margin="6,0,0,0" Click="AlPegarClave" />
                                </Grid>
                                <TextBlock x:Name="_huellaClave" Style="{StaticResource Tenue}"
                                           FontFamily="{StaticResource FuenteMono}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="_clavePrivadaHeredada"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />

                                <TextBlock Text="Certificado firmado por CA (opcional)"
                                           Style="{StaticResource Etiqueta}" Margin="0,12,0,4" />
                                <TextBox x:Name="_certificadoSsh"
                                         TextChanged="AlCambiarCampoHeredable" />
                                <TextBlock x:Name="_certificadoSshHeredado"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Conexión" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Keep-alive, en segundos (vacío = sin definir aquí; 0 desactiva)"
                                           Style="{StaticResource Etiqueta}" TextWrapping="Wrap" />
                                <TextBox x:Name="_sshKeepAlive" TextChanged="AlCambiarCampoHeredable" />
                                <TextBlock x:Name="_sshKeepAliveHeredado"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="_error" Grid.Row="2" Foreground="{DynamicResource Destructivo}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    IsCancel="True" MinWidth="100" />
            <Button Content="Guardar" Style="{StaticResource BotonPrimario}"
                    IsDefault="True" MinWidth="100" Margin="8,0,0,0" Click="AlGuardar" />
        </StackPanel>
    </Grid>
</Window>
