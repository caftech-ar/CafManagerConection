<Window x:Class="CafManagerConection.App.Views.ConnectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="880" MinWidth="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Fondo}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="_pestanas" Grid.Row="0" MinHeight="300">

            <TabItem x:Name="_pestanaGeneral">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="General" />
                        <TextBlock x:Name="_avisoErrorGeneral" Text=" ⚠" FontWeight="Bold"
                                   Foreground="{DynamicResource Destructivo}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="4,14,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Identidad" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Protocolo" Style="{StaticResource Etiqueta}" />
                                <ComboBox x:Name="_protocolo" SelectionChanged="AlCambiarProtocolo">
                                    <ComboBoxItem Content="RDP" />
                                    <ComboBoxItem Content="SSH" />
                                    <ComboBoxItem Content="Web" />
                                </ComboBox>

                                <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}"
                                           Margin="0,12,0,4" />
                                <TextBox x:Name="_nombre" TextChanged="AlCambiarNombre" />
                                <TextBlock x:Name="_nombreDuplicado"
                                           Foreground="{DynamicResource Destructivo}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />

                                <StackPanel x:Name="_bloqueHost">
                                    <TextBlock Text="Host o dirección IP"
                                               Style="{StaticResource Etiqueta}" Margin="0,12,0,4" />
                                    <TextBox x:Name="_host" />
                                </StackPanel>

                                <StackPanel x:Name="_bloquePuerto">
                                    <TextBlock x:Name="_etiquetaPuerto" Style="{StaticResource Etiqueta}"
                                               Margin="0,12,0,4"
                                               Text="Puerto (vacío = heredar de la carpeta)" />
                                    <TextBox x:Name="_puerto" TextChanged="AlCambiarCampoHeredable" />
                                    <TextBlock x:Name="_puertoHeredado" Style="{StaticResource Tenue}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>

                                <TextBlock Text="Descripción (una línea, se ve en el árbol)"
                                           Style="{StaticResource Etiqueta}" Margin="0,12,0,4" />
                                <TextBox x:Name="_descripcion" MaxLength="200" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Ubicación" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Carpeta" Style="{StaticResource Etiqueta}" />
                                <ComboBox x:Name="_carpeta" DisplayMemberPath="Nombre"
                                          SelectionChanged="AlCambiarCarpeta" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Apariencia" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Etiqueta (vacío = heredar de la carpeta)"
                                           Style="{StaticResource Etiqueta}" />
                                <ComboBox x:Name="_etiqueta" SelectionChanged="AlCambiarCampoHeredable" />
                                <TextBlock x:Name="_etiquetaHeredada" Style="{StaticResource Tenue}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />

                                <TextBlock Text="Color del icono" Style="{StaticResource Etiqueta}"
                                           Margin="0,14,0,4" />
                                <WrapPanel x:Name="_colores" />

                                <TextBlock Text="Forma del icono" Style="{StaticResource Etiqueta}"
                                           Margin="0,10,0,4" />
                                <WrapPanel x:Name="_iconos" />

                                <CheckBox x:Name="_favorita" Content="Favorita" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="_pestanaProtocolo">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Protocolo" />
                        <TextBlock x:Name="_avisoErrorProtocolo" Text=" ⚠" FontWeight="Bold"
                                   Foreground="{DynamicResource Destructivo}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="4,14,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border x:Name="_seccionCuenta" Style="{StaticResource Tarjeta}"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Cuenta" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Usuario (vacío = heredar)"
                                           Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="_usuario" TextChanged="AlCambiarCampoHeredable" />
                                <TextBlock x:Name="_usuarioHeredado" Style="{StaticResource Tenue}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />

                                <StackPanel x:Name="_bloqueDominio" Visibility="Collapsed">
                                    <TextBlock Text="Dominio (opcional)"
                                               Style="{StaticResource Etiqueta}" Margin="0,12,0,4" />
                                    <TextBox x:Name="_dominio" TextChanged="AlCambiarCampoHeredable" />
                                    <TextBlock x:Name="_dominioHeredado" Style="{StaticResource Tenue}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="_bloqueCredencial" Style="{StaticResource Tarjeta}"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Credenciales" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Contraseña (se guarda cifrada en el vault de CMC)"
                                           Style="{StaticResource Etiqueta}" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <PasswordBox x:Name="_clave" />
                                        <TextBox x:Name="_claveVisible" IsReadOnly="True"
                                                 Visibility="Collapsed" />
                                    </Grid>
                                    <Button Grid.Column="1" x:Name="_ojoClave"
                                            Style="{StaticResource BotonSecundario}"
                                            MinWidth="34" Margin="6,0,0,0" Padding="0"
                                            Click="AlAlternarVerClave"
                                            ToolTip="Mostrar u ocultar la contraseña">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Data="{DynamicResource IconoOjo}"
                                              Fill="{DynamicResource TextoTenue}" />
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="_claveGuardada"
                                           Text="Hay una contraseña guardada"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           Margin="0,4,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="_bloqueRdpAvanzadoIzq" Visibility="Collapsed">
                            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Programa inicial" Style="{StaticResource Titulo}"
                                               FontSize="14" Margin="0,0,0,10" />

                                    <TextBlock Text="Programa a abrir en lugar del escritorio (vacío = escritorio completo)"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,2" />
                                    <TextBox x:Name="_rdpProgramaInicial"
                                             TextChanged="AlCambiarCampoHeredable" />
                                    <TextBlock x:Name="_rdpProgramaInicialHeredado"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed" />

                                    <TextBlock Text="Directorio de trabajo (opcional)" Margin="0,10,0,2" />
                                    <TextBox x:Name="_rdpDirectorioTrabajo" />

                                    <CheckBox x:Name="_rdpRemoteApp"
                                              Content="Abrir como RemoteApp (sólo si el servidor lo publicó)"
                                              Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Seguridad" Style="{StaticResource Titulo}"
                                               FontSize="14" Margin="0,0,0,10" />

                                    <CheckBox x:Name="_rdpIgnorarCertificado"
                                              Content="Ignorar advertencias de certificado (no recomendado)"
                                              IsThreeState="True"
                                              Checked="AlCambiarCampoHeredable"
                                              Unchecked="AlCambiarCampoHeredable"
                                              Indeterminate="AlCambiarCampoHeredable" />
                                    <TextBlock Text="Sin marcar/marcar/heredar (tres estados); si nadie lo define, se validan: eso es lo seguro"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,2" />
                                    <TextBlock x:Name="_rdpIgnorarCertificadoHeredado"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,10"
                                               Visibility="Collapsed" />

                                    <CheckBox x:Name="_rdpIdentidadDeWindows"
                                              Content="Usar mi identidad de Windows"
                                              Checked="AlCambiarLaIdentidadDeWindows"
                                              Unchecked="AlCambiarLaIdentidadDeWindows" />
                                    <TextBlock Text="Entra con la sesión de Windows con la que estás logueado, sin escribir ni guardar ninguna contraseña. Fuera del dominio, o si el servidor no confía, se piden las credenciales como siempre"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border x:Name="_bloqueUrl" Style="{StaticResource Tarjeta}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Destino" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Dirección URL" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="_url" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border x:Name="_seccionAutenticacion" Style="{StaticResource Tarjeta}"
                                Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Autenticación" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Método de autenticación"
                                           Style="{StaticResource Etiqueta}" />
                                <ComboBox x:Name="_sshMetodoAuth"
                                          SelectionChanged="AlCambiarCampoHeredable">
                                    <ComboBoxItem Content="Automático (clave si hay cargada; si no, contraseña)" />
                                    <ComboBoxItem Content="Contraseña" />
                                    <ComboBoxItem Content="Clave privada" />
                                </ComboBox>
                                <TextBlock x:Name="_sshMetodoAuthHeredado"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />

                                <TextBlock Text="Ruta de la clave privada (SSH, opcional; vacío = heredar)"
                                           Style="{StaticResource Etiqueta}" Margin="0,12,0,4"
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="_claveSshRuta" Grid.Column="0"
                                             TextChanged="AlCambiarRutaDeClaveSsh" />
                                    <Button Grid.Column="1" Content="..."
                                            Style="{StaticResource BotonSecundario}"
                                            MinWidth="30" Margin="6,0,0,0" Click="AlExaminarClaveSsh"
                                            ToolTip="Elegir un archivo existente" />
                                    <Button Grid.Column="2" Content="Pegar clave..."
                                            Style="{StaticResource BotonSecundario}"
                                            Margin="6,0,0,0" Click="AlPegarClaveSsh" />
                                </Grid>
                                <TextBlock x:Name="_huellaClaveSsh" Style="{StaticResource Tenue}"
                                           FontFamily="{StaticResource FuenteMono}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="_claveSshRutaHeredada"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />

                                <TextBlock Text="Certificado firmado por CA (SSH, opcional; vacío = heredar)"
                                           Style="{StaticResource Etiqueta}" Margin="0,12,0,4"
                                           TextWrapping="Wrap" />
                                <TextBox x:Name="_certificadoSsh"
                                         TextChanged="AlCambiarCampoHeredable" />
                                <TextBlock x:Name="_certificadoSshHeredado"
                                           Style="{StaticResource Tenue}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="_bloqueRdpAvanzado" Visibility="Collapsed">
                            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Sesión" Style="{StaticResource Titulo}"
                                               FontSize="14" Margin="0,0,0,10" />

                                    <CheckBox x:Name="_rdpPortapapeles"
                                              Content="Portapapeles compartido"
                                              IsThreeState="True"
                                              Checked="AlCambiarCampoHeredable"
                                              Unchecked="AlCambiarCampoHeredable"
                                              Indeterminate="AlCambiarCampoHeredable" />
                                    <TextBlock Text="Sin marcar/marcar/heredar (tres estados); si nadie lo define, habilitado"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,2" />
                                    <TextBlock x:Name="_rdpPortapapelesHeredado"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,10"
                                               Visibility="Collapsed" />

                                    <TextBlock Text="Al cambiar el tamaño de la pestaña"
                                               Margin="0,4,0,2" />
                                    <ComboBox x:Name="_rdpModoTamano"
                                              SelectionChanged="AlCambiarCampoHeredable">
                                        <ComboBoxItem Content="Heredar" />
                                        <ComboBoxItem Content="Sin ajustar (resolución fija)" />
                                        <ComboBoxItem Content="Escalar los píxeles" />
                                        <ComboBoxItem Content="Renegociar la resolución (servidor moderno)" />
                                    </ComboBox>
                                    <TextBlock x:Name="_rdpModoTamanoHeredado"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Pantalla y rendimiento" Style="{StaticResource Titulo}"
                                               FontSize="14" Margin="0,0,0,10" />

                                    <TextBlock Text="Apagar para aliviar un enlace lento:" Margin="0,0,0,4" />
                                    <CheckBox x:Name="_rdpSinFondo" Content="Fondo de escritorio" />
                                    <CheckBox x:Name="_rdpSinTemas" Content="Temas visuales" Margin="0,2,0,0" />
                                    <CheckBox x:Name="_rdpSinAnimaciones" Content="Animaciones de menú" Margin="0,2,0,0" />
                                    <CheckBox x:Name="_rdpSinArrastre" Content="Contenido de la ventana al arrastrar" Margin="0,2,0,0" />

                                    <TextBlock Text="Tipo de red" Margin="0,10,0,2" />
                                    <ComboBox x:Name="_rdpTipoRed"
                                              SelectionChanged="AlCambiarCampoHeredable">
                                        <ComboBoxItem Content="Heredar" />
                                        <ComboBoxItem Content="Automático" />
                                        <ComboBoxItem Content="LAN" />
                                        <ComboBoxItem Content="Banda ancha alta" />
                                        <ComboBoxItem Content="Banda ancha baja" />
                                        <ComboBoxItem Content="WAN" />
                                        <ComboBoxItem Content="Satelital" />
                                        <ComboBoxItem Content="Módem" />
                                    </ComboBox>
                                    <TextBlock x:Name="_rdpTipoRedHeredado"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed" />

                                    <TextBlock Text="Escala del escritorio" Margin="0,10,0,2" />
                                    <ComboBox x:Name="_rdpEscalaEscritorio"
                                              SelectionChanged="AlCambiarCampoHeredable">
                                        <ComboBoxItem Content="Heredar" />
                                        <ComboBoxItem Content="100 %" />
                                        <ComboBoxItem Content="125 %" />
                                        <ComboBoxItem Content="150 %" />
                                        <ComboBoxItem Content="175 %" />
                                        <ComboBoxItem Content="200 %" />
                                    </ComboBox>
                                    <TextBlock x:Name="_rdpEscalaEscritorioHeredado"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed" />

                                    <TextBlock Text="Escala del dispositivo" Margin="0,10,0,2" />
                                    <ComboBox x:Name="_rdpEscalaDispositivo"
                                              SelectionChanged="AlCambiarCampoHeredable">
                                        <ComboBoxItem Content="Heredar" />
                                        <ComboBoxItem Content="100 %" />
                                        <ComboBoxItem Content="140 %" />
                                        <ComboBoxItem Content="180 %" />
                                    </ComboBox>
                                    <TextBlock x:Name="_rdpEscalaDispositivoHeredado"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <Border x:Name="_bloqueNavegadorWeb" Style="{StaticResource Tarjeta}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Navegador" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Navegador (vacío = el predeterminado del sistema)"
                                           Style="{StaticResource Etiqueta}" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="_webNavegador" Grid.Column="0" />
                                    <Button Grid.Column="1" Content="..."
                                            Style="{StaticResource BotonSecundario}"
                                            MinWidth="30" Margin="6,0,0,0"
                                            Click="AlExaminarNavegador"
                                            ToolTip="Elegir el ejecutable del navegador" />
                                </Grid>

                                <CheckBox x:Name="_ventanaPrivada" Content="Abrir en ventana privada"
                                          Margin="0,12,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="_pestanaAvanzado">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Avanzado" />
                        <TextBlock x:Name="_avisoErrorAvanzado" Text=" ⚠" FontWeight="Bold"
                                   Foreground="{DynamicResource Destructivo}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="4,14,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Conexión" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Cuelga de (vacío = ninguna)"
                                           Style="{StaticResource Etiqueta}" />
                                <ComboBox x:Name="_padre" />

                                <!-- Vacío hereda; si nadie lo define, 60 segundos (Defaults.SshKeepAliveSeconds). 0 desactiva el keep-alive y no es «sin definir» -->
                                <StackPanel x:Name="_bloqueKeepAliveSsh" Visibility="Collapsed">
                                    <TextBlock Text="Keep-alive SSH, en segundos (vacío = heredar; 0 desactiva; por omisión 60)"
                                               Style="{StaticResource Etiqueta}" Margin="0,12,0,4"
                                               TextWrapping="Wrap" />
                                    <TextBox x:Name="_sshKeepAlive"
                                             TextChanged="AlCambiarCampoHeredable" />
                                    <TextBlock x:Name="_sshKeepAliveHeredado"
                                               Style="{StaticResource Tenue}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Documentación" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <TextBlock Text="Documentación (http o https)"
                                           Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="_documentacion" />

                                <TextBlock Text="Notas" Style="{StaticResource Etiqueta}"
                                           Margin="0,12,0,4" />
                                <TextBox x:Name="_notas" Style="{StaticResource CampoMultilinea}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Campos propios" Style="{StaticResource Titulo}"
                                           FontSize="14" Margin="0,0,0,10" />

                                <DataGrid x:Name="_camposPropiosGrid" AutoGenerateColumns="False"
                                          IsReadOnly="False" CanUserAddRows="False" MaxHeight="160">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nombre" Width="*"
                                                            Binding="{Binding Nombre}" />
                                        <DataGridTextColumn Header="Valor" Width="*"
                                                            Binding="{Binding Valor}" />
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Quitar"
                                                            Style="{StaticResource BotonTenue}"
                                                            Click="AlQuitarCampoPropio" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Agregar campo" Style="{StaticResource BotonSecundario}"
                                        HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Click="AlAgregarCampoPropio" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="_error" Grid.Row="1" Foreground="{DynamicResource Destructivo}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    IsCancel="True" MinWidth="100" />
            <Button Content="Guardar" Style="{StaticResource BotonPrimario}"
                    IsDefault="True" MinWidth="100" Margin="8,0,0,0"
                    Click="AlGuardar" />
        </StackPanel>
    </Grid>
</Window>
