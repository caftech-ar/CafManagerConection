<UserControl x:Class="CafManagerConection.App.Views.BitacorasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Lateral}"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Conexión" Style="{StaticResource Etiqueta}" />
                <ComboBox x:Name="_filtro" Margin="0,4,0,0"
                          SelectionChanged="AlCambiarFiltro" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0">
                <Grid>
                    <TextBlock x:Name="_vacio"
                               Style="{StaticResource Tenue}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="16"
                               Visibility="Collapsed" />

                    <DataGrid x:Name="_listado"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionChanged="AlElegirBitacora">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cuándo" Binding="{Binding Cuando}"
                                                Width="Auto" />
                            <DataGridTextColumn Header="Conexión" Binding="{Binding Conexion}"
                                                Width="*" />
                            <DataGridTextColumn Header="Tamaño" Binding="{Binding Tamano}"
                                                Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" x:Name="_resumen"
                       Style="{StaticResource Tenue}"
                       Margin="0,10,0,0" />
        </Grid>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                      Background="Transparent" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="_busqueda" Width="240"
                         Style="{StaticResource CampoBusqueda}"
                         Tag="Buscar en la bitácora…"
                         KeyDown="AlTeclearEnBusqueda" />

                <Button Content="Buscar" Style="{StaticResource BotonSecundario}"
                        Width="90" Margin="8,0,0,0" Click="AlBuscar" />

                <TextBlock x:Name="_estadoBusqueda" Style="{StaticResource Tenue}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0">
                <!-- Height en Auto: el estilo implícito de TextBox fija el alto de un control de
                     una línea, y el contenido entraba en 32 px -->
                <TextBox x:Name="_contenido"
                         IsReadOnly="True"
                         Height="Auto"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="10"
                         FontFamily="{StaticResource FuenteMono}"
                         FontSize="{StaticResource CuerpoChico}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="_masAtras"
                        Content="Cargar lo anterior"
                        Style="{StaticResource BotonSecundario}"
                        Width="160"
                        IsEnabled="False"
                        Click="AlCargarLoAnterior" />

                <TextBlock x:Name="_estadoContenido" Style="{StaticResource Tenue}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
